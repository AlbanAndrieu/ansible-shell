---
# Paths are relative to the project root (ansible-lint >= 25 no longer matches a leading "./")
exclude_paths:
  - .cache/ # implicit unless exclude_paths is defined in config
  - .github/
  - .gitlab/
  - .venv/
  - report/
  - requirements.yml
  - docker/
  - roles/ # galaxy roles installed from requirements.yml
  - collections/
  - ansible_collections/
  - megalinter-reports/
# parseable: true
# quiet: true
# rulesdir:
#  - ./rule/directory/
# tags:
#   - run_this_tag
warn_list: # or 'skip_list' to silence them completely
  - yaml # Violations reported by yamllint
use_default_rules: true
# verbosity: 1

# Offline mode disables installation of requirements.yml
offline: true
