---
# Usage : yamllint . --config-file .yamllint
# extends: default
extends: relaxed
rules:
  # to match ansible-lint --write
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
    level: error
  brackets:
    max-spaces-inside: 1
    level: error
  comments:
    min-spaces-from-content: 1
  line-length: disable
  indentation:
    spaces: 2
  # document-start: disable
  # truthy: disable
  # NOTE(retr0h): Templates no longer fail this lint rule.
  #               Uncomment if running old Molecule templates.
  # Settings required by ansible-lint --fix, see https://docs.ansible.com/projects/lint/rules/yaml/
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false # GitHub workflows use the "on" key
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
ignore: |-
  .direnv/
  .venv/
  .git/
  .tox
  .cache
  roles/
  .ansible-lint
  .github/
  .gitlab-ci.yml
  node_modules/
  .pre-commit-config.yaml
  .megalinter-reports/
  .gitguardian.yaml
