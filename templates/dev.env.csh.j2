#!/bin/csh
# {{ ansible_managed }}
# csh counterpart of dev.env.sh, sourced by ~/.cshrc

####################
### PROJECT
####################

if (! $?PROJECT_USER) then
  echo "Undefined parameter : PROJECT_USER, use the default one"
  setenv PROJECT_USER {{ shell_env_project_user }}
endif

if (! $?PROJECT_VERSION) then
  echo "Undefined parameter : PROJECT_VERSION, use the default one"
  setenv PROJECT_VERSION {{ shell_env_project_version }}
endif

if (! $?DRIVE_PATH) then
  setenv DRIVE_PATH "{{ shell_env_drive_path }}"
endif

if (! $?PROJECT_HOME) then
  echo "Undefined parameter : PROJECT_HOME, use the default one"
  setenv PROJECT_HOME {{ shell_env_project_home }}
endif

if (! $?WORKSPACE_ENV) then
  echo "Undefined parameter : WORKSPACE_ENV, use the default one"
  setenv WORKSPACE_ENV {{ shell_env_workspace_env }}
endif

if (! $?PROJECT_EXTRACTION) then
  setenv PROJECT_EXTRACTION {{ shell_env_project_extraction }}
endif

if (! $?TERM) then
  setenv TERM {{ shell_env_term }}
endif

if (! $?EDITOR) then
  setenv EDITOR {{ shell_env_editor }}
endif

setenv PATH /usr/local/bin:/usr/sbin:/sbin:/usr/bin:/bin
if (-d ${HOME}/bin) then
  setenv PATH ${HOME}/bin:${PATH}
endif
if (-d /snap/bin) then
  setenv PATH /snap/bin:${PATH}
endif

setenv PROJECT_MAJOR_VERSION ${PROJECT_VERSION}
setenv PROJECT_BUILD_TYPE {{ shell_env_project_build_type }}

setenv PROJECT_DEV ${PROJECT_HOME}/${PROJECT_USER}${PROJECT_MAJOR_VERSION}
echo "PROJECT_USER : ${PROJECT_USER} PROJECT_DEV : ${PROJECT_DEV}"
setenv PROJECT_SRC ${PROJECT_DEV}/${PROJECT_EXTRACTION}
setenv PROJECT_TARGET_PATH {{ shell_env_project_target_path }}

if (! -d ${PROJECT_DEV}) then
  echo "ERROR: Directory ${PROJECT_DEV} doesn't exist!"
endif

# This variable must not be set if jenkins is used
if (! $?WORKSPACE) then
  setenv WORKSPACE ${PROJECT_DEV}
endif

if (-d ${HOME}/.local/bin) then
  setenv PATH ${HOME}/.local/bin:${PATH}
endif

####################
### JAVA
####################

setenv JAVA_HOME "{{ shell_env_java_home }}"
setenv JAVA_OPTS "{{ shell_env_java_opts }}"

####################
### MAVEN
####################

setenv M2_HOME {{ shell_env_m2_home }}
setenv M2 ${M2_HOME}/bin
setenv PATH ${M2}:${PATH}
setenv MAVEN_OPTS "{{ shell_env_maven_opts }}"
setenv MAVEN_COLOR true
setenv M2_REPO {{ shell_env_maven_local_repo_path }}

####################
### DOCKER
####################

setenv DOCKER_CLIENT_TIMEOUT 240
setenv COMPOSE_HTTP_TIMEOUT 2000
setenv DOCKER_REGISTRY_USER "{{ shell_env_docker_registry_user }}"

####################
### MISC
####################

setenv GIT_DISCOVERY_ACROSS_FILESYSTEM 1

setenv LANGUAGE {{ shell_env_lang }}
setenv LANG {{ shell_env_lang }}
setenv LC_ALL {{ shell_env_lang }}
setenv LC_CTYPE {{ shell_env_lang }}

setenv PAGER {{ shell_env_pager }}
setenv ANSIBLE_NOCOWS 1

alias cde 'cd ${PROJECT_DEV}/${PROJECT_EXTRACTION}'
alias cdr 'cd ${PROJECT_DEV}'

echo "PATH is ${PATH}"
