#!/bin/bash
# shellcheck disable=SC2148
#
# Tooling is declared in mise.toml (python, uv, node...) and python
# dependencies in pyproject.toml / uv.lock.
#
#   brew install mise direnv
#   mise install && mise run install
#

if ! has mise; then
  log_error "mise not found: brew install mise (macOS) or curl https://mise.run | sh (Linux)"
  exit 1
fi

watch_file mise.toml mise.lock pyproject.toml uv.lock .python-version

# Export tools and the .venv declared in mise.toml
eval "$(mise env --shell bash)"

if [ ! -x ".venv/bin/ansible" ]; then
  log_status "Python dependencies missing, run: mise run install"
fi

#
# Environment configuration
# =========================
#
dotenv_if_exists .env
dotenv_if_exists .env.secrets
source_env_if_exists .env.local

# See https://github.com/direnv/direnv/wiki/PS1
unset PS1
